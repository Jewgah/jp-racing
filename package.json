{
  "name": "jp-racing",
  "version": "2.0.0",
  "private": true,
  "description": "JP Racing: a modernised fork of pmndrs/racing-game on React 19 and React Three Fiber 9",
  "type": "module",
  "keywords": [
    "physics",
    "cannon-es",
    "vehicle",
    "react-three-fiber"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "prettier": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "prettier-fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\""
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/cannon": "^6.6.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "leva": "^0.10.1",
    "lodash-es": "^4.18.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.2",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
